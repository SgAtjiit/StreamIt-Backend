        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var responseData = pm.response.json();",
                  "    if (responseData.data && responseData.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', responseData.data.accessToken);",
                  "        console.log('accessToken set successfully');",
                  "    }",
                  "    if (responseData.data && responseData.data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', responseData.data.refreshToken);",
                  "        console.log('refreshToken set successfully');",
                  "    }",
                  "    if (responseData.data && responseData.data.user && responseData.data.user._id) {",
                  "        pm.collectionVariables.set('userId', responseData.data.user._id);",
                  "        console.log('userId set successfully');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
